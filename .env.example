# FinTalent Monitor — shared Supabase project-monitor architecture

# Preferred Supabase credentials (never use anon/publishable keys for writes)
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Fallback only when SUPABASE_SECRET_KEY is absent
# SUPABASE_SERVICE_ROLE_KEY=

# Optional migration / CLI tooling
# SUPABASE_PROJECT_REF=
# SUPABASE_ACCESS_TOKEN=
# SUPABASE_DB_PASSWORD=
# SUPABASE_DB_URL=

# FinTalent auth
FINTALENT_EMAIL=
FINTALENT_PASSWORD=

# SMTP alerts
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SENDER_EMAIL=
SENDER_PASSWORD=
RECIPIENT_EMAILS=
ERROR_RECIPIENT_EMAIL=

# Runtime
CHECK_INTERVAL=300
# Skip re-processing the same source project_id when latest scraped_at age <= N days
OCCURRENCE_WINDOW_DAYS=7
# REPOST_MIN_DAYS=7
HEADLESS=True

# Browser overrides (Docker/Railway)
# CHROME_BIN=/usr/bin/google-chrome
# CHROMEDRIVER_PATH=

# Detail fetch / enrichment
DETAIL_FETCH_DELAY_SECONDS=2
DETAIL_FETCH_MAX_ATTEMPTS=2
DETAIL_AUTO_ENRICHMENT_ENABLED=true
DETAIL_MAX_AUTOMATIC_ATTEMPTS=3
DETAIL_RETRY_COOLDOWN_MINUTES=360

# Email retries
EMAIL_MAX_RETRIES=3
EMAIL_RETRY_BASE_MINUTES=15

# Distributed worker lock
FINTALENT_WORKER_LOCK_TTL_SECONDS=180

# First non-cold scan after process start: suppress project emails when true
SUPPRESS_PROJECT_EMAILS_ON_FIRST_SCAN=false

# Process recycle (Chrome leak prevention). start.sh relaunches after exit.
PROCESS_RECYCLE_HOURS=3
# PROCESS_HARD_TIMEOUT_SECONDS=11700

# Operational error emails — 0 means unlimited / no delay (email every failure)
ERROR_EMAIL_COOLDOWN_MINUTES=0
INCIDENT_CONSECUTIVE_FAILURE_THRESHOLD=1
INCIDENT_OPEN_AFTER_MINUTES=0
INCIDENT_REMINDER_HOURS=0
INCIDENT_MAX_EMAILS=0
PLATFORM_MAX_ERROR_EMAILS_PER_DAY=0

# MONGO_URI is NOT used by production runtime.
# It may be set only for the optional migration script:
#   python scripts/migrate_fintalent_mongo_to_supabase.py --dry-run
# MONGO_URI=
